{
  "name": "read-permalink",
  "version": "0.2.0",
  "type": "module",
  "description": "read URL search parameters and packed state from permalinks",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/read-permalink.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run readme && build_lib --terser-strength max",
    "readme": "bun tldw",
    "test": "bun test --max-concurrency 1 ./test"
  },
  "dependencies": {
    "decode-brotli": "0.1.0",
    "decode-zstd": "0.1.0",
    "fflate": "0.8.3",
    "from-base64": "0.1.0"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-jaid": "34.0.0",
    "tldw": "9.7.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.2"
  }
}